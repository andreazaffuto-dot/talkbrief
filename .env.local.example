# Get your API key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_api_key_here

# Get your API key at https://supadata.ai (100 free requests/month, no credit card)
SUPADATA_API_KEY=your_supadata_api_key_here

# Stripe — https://dashboard.stripe.com/apikeys
# Use sk_test_... for development, sk_live_... for production
STRIPE_SECRET_KEY=sk_test_...

# Create a recurring product in the Stripe dashboard (12€/month), then paste the Price ID here
# Dashboard → Products → Add product → Recurring → 12 EUR/month → copy "Price ID" (price_...)
STRIPE_PRICE_ID=price_...
